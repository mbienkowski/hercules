{
  // Emit config: compiles each domain's own .mts logic into .local/ts-out/, never its tests/ (which
  // now live outside src/ entirely, under the top-level tests/ tree). Sources are .mts and emit .mjs,
  // which Node loads as ESM regardless of package.json — see tsconfig.base.json for why that file
  // must never gain a "type" field.
  //
  // .local/ts-out/ sits under the single gitignored /.local/ transients tree. `rootDir: "internal"`
  // makes each domain emit under its own subtree.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": ".local/ts-out",
    "rootDir": "internal",
    "sourceMap": true
  },
  "include": ["internal/builder/**/*.mts", "internal/release/**/*.mts"]
}
