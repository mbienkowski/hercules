{
  // Emit config: compiles the production toolchain (src/builder/, src/release/, src/metrics/ — every
  // domain's own .mts logic, never its tests/ or bin/ shims' non-.mts siblings) into .ts-out/.
  // See tsconfig.base.json for why package.json must never gain a "type" field.
  //
  // Sources are .mts and emit .mjs, which Node always loads as ESM regardless of package.json.
  // That is what keeps the "type" field absent — and therefore dist/opencode/plugin.js CommonJS —
  // while letting the toolchain import ESM-only dependencies normally. js-tiktoken in particular
  // publishes one shared `types` condition for both its CJS and ESM entries, so a CommonJS
  // consumer cannot type-check against it at all.
  //
  // .ts-out/ is gitignored and is deliberately NOT named build/: /build/ is already an ignore rule
  // and pytest's norecursedirs is documented around that name, so reusing it would collide with
  // two live rules. Its internal shape mirrors the three domains: .ts-out/builder/, .ts-out/release/,
  // .ts-out/metrics/ — `rootDir: "src"` strips the shared `src/` prefix so each domain emits under
  // its own matching subtree (and the .ts-out/ layout stays independent of where the sources sit).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": ".ts-out",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/builder/**/*.mts", "src/release/**/*.mts", "src/metrics/**/*.mts"]
}
