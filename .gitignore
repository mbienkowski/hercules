# Build output
/build/

# Node / TypeScript
node_modules/
# tsc output. Deliberately NOT named build/ — /build/ above is already ignored and pytest's
# norecursedirs is documented around that name, so reusing it would collide with two existing rules.
/.ts-out/
*.tsbuildinfo
.stryker-tmp/
reports/
coverage/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
.coverage
.pytest_cache/
.mutmut-cache
/mutmut-results.txt

# Runtime state (lives in the cloned copy at ~/.hercules on user machines)
.last-pull
/hercules-config.json
/credentials.json

# Editor
.DS_Store
*.swp

# Personal root project instructions (only plugin/CLAUDE.md is committed)
/CLAUDE.md

# Hercules temporary artifacts (planning, intermediate drafts)
docs/tmp/

# IntelliJ IDEA
.idea/*
# Claude Code IDE settings (machine-local)
.claude/
# OpenCode CLI scratch state (machine-local, unrelated to the project)
.opencode/
