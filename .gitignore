# Transients: regenerable by one `make` target, machine-local, never committed
/.local/

# Node / TypeScript
node_modules/
# Every transient tool output (tsc's ts-out/, coverage/, .stryker-tmp/, mutation reports, pytest's
# cache, the .coverage data file) lives under the single /.local/ tree above — nothing else to
# ignore here.
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
# mutmut's own cache/results files are not redirectable into .local/ (no configurable path in
# mutmut>=2.4,<3), so they stay at the root as their own entries.
.mutmut-cache
/mutmut-results.txt

# Runtime state (lives in the cloned copy at ~/.hercules on user machines)
.last-pull
/hercules-config.json
/credentials.json

# Editor
.DS_Store
*.swp

# Personal root project instructions (the committed CLAUDE.md is the built dist/<eco>/CLAUDE.md,
# authored at src/content/persona.md)
/CLAUDE.md

# Hercules temporary artifacts (planning, intermediate drafts)
docs/tmp/

# IntelliJ IDEA
.idea/*
# Claude Code IDE settings (machine-local)
.claude/
# OpenCode CLI scratch state (machine-local, unrelated to the project)
.opencode/
