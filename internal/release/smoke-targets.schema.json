{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hercules.dev/smoke-targets.schema.json",
  "title": "Hercules live-CLI smoke declarations",
  "description": "One entry per distribution: which real binary to install and which spec proves the built plugin loads in it. Kept OUT of the recipe files on purpose — a recipe says what a distribution CONTAINS, and this says how CI proves the result works, which is a different question with a different reader. The smoke matrix fails closed against the recipe directory: a distribution with no entry here, or an entry naming no distribution, stops the release rather than silently skipping a leg.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/smoke"
      }
    }
  },
  "$defs": {
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli",
        "test",
        "expect"
      ],
      "properties": {
        "cli": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "install": {
          "$ref": "#/$defs/install"
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version_cmd"
          ],
          "properties": {
            "version_cmd": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "description": "The CI live check for this tool."
    },
    "install": {
      "type": "object",
      "discriminator": {
        "propertyName": "method"
      },
      "required": [
        "method"
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/installPackage"
        },
        {
          "$ref": "#/$defs/installScript"
        }
      ],
      "properties": {
        "method": {
          "type": "string"
        }
      }
    },
    "installPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "name",
        "version"
      ],
      "properties": {
        "method": {
          "const": "package"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Pinned: an unpinned live check turns red on someone else's release."
        }
      }
    },
    "installScript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "url"
      ],
      "properties": {
        "method": {
          "const": "script"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "flags": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
