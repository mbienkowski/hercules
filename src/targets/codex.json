{
  "schema": 1,
  "name": "codex",
  "vars": {
    "product": "Codex",
    "host": "Codex",
    "ns": "$hercules-",
    "instructions_file": "AGENTS.md",
    "agent_ns": "",
    "plugin_root": "${PLUGIN_ROOT}/",
    "plan_enter": "plan mode",
    "plan_exit": "approval"
  },
  "models": {
    "high": null,
    "medium": null,
    "low": null
  },
  "smoke": {
    "npm_package": "@openai/codex",
    "npm_version": "0.146.0",
    "cli": "codex",
    "test": "builder/tests/smoke/codexSmoke.spec.ts",
    "expect": {
      "version_cmd": [
        "codex",
        "--version"
      ]
    }
  },
  "dispatch": "path",
  "roles": {
    "agent": {
      "mode": "fields",
      "body": "keep",
      "fields": [
        {
          "key": "name",
          "from": "stem_prefix",
          "prefix": "hercules-advisor-"
        },
        {
          "key": "description",
          "from": "frontmatter",
          "field": "description",
          "render": true
        }
      ]
    },
    "command": {
      "mode": "fields",
      "body": "lstrip_newlines",
      "fields": [
        {
          "key": "name",
          "from": "stem_prefix",
          "prefix": "hercules-"
        },
        {
          "key": "description",
          "from": "frontmatter",
          "field": "description",
          "render": true
        }
      ]
    },
    "persona": {
      "mode": "plain"
    },
    "default": {
      "mode": "preserve"
    }
  },
  "routes": [
    {
      "kind": "exact",
      "src": "capabilities.md",
      "dest": "CAPABILITIES.md"
    },
    {
      "kind": "exact",
      "src": "persona.md",
      "dest": "AGENTS.md"
    },
    {
      "kind": "exact",
      "src": "commands/build.md",
      "dest": "skills/hercules-build/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "commands/design.md",
      "dest": "skills/hercules-design/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "commands/discover.md",
      "dest": "skills/hercules-discover/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "commands/project-reset.md",
      "dest": "skills/hercules-project-reset/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "commands/ship.md",
      "dest": "skills/hercules-ship/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "commands/workflow.md",
      "dest": "skills/hercules-workflow/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/backend-engineer.md",
      "dest": "skills/hercules-advisor-backend-engineer/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/business-analyst.md",
      "dest": "skills/hercules-advisor-business-analyst/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/challenger.md",
      "dest": "skills/hercules-advisor-challenger/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/copywriter.md",
      "dest": "skills/hercules-advisor-copywriter/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/cynical-reviewer.md",
      "dest": "skills/hercules-advisor-cynical-reviewer/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/devops-engineer.md",
      "dest": "skills/hercules-advisor-devops-engineer/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/document-specialist.md",
      "dest": "skills/hercules-advisor-document-specialist/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/frontend-engineer.md",
      "dest": "skills/hercules-advisor-frontend-engineer/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/hercules.md",
      "dest": "skills/hercules-advisor-hercules/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/lead-architect.md",
      "dest": "skills/hercules-advisor-lead-architect/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/maintainer.md",
      "dest": "skills/hercules-advisor-maintainer/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/security-expert.md",
      "dest": "skills/hercules-advisor-security-expert/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/senior-qa-engineer.md",
      "dest": "skills/hercules-advisor-senior-qa-engineer/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/simplicity-advocate.md",
      "dest": "skills/hercules-advisor-simplicity-advocate/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/source-checker.md",
      "dest": "skills/hercules-advisor-source-checker/SKILL.md"
    },
    {
      "kind": "exact",
      "src": "agents/ux-ui-designer.md",
      "dest": "skills/hercules-advisor-ux-ui-designer/SKILL.md"
    }
  ],
  "artifacts": [
    {
      "dest": ".codex-plugin/plugin.json",
      "versioned": true,
      "content": {
        "name": "hercules",
        "description": "Methodology & workflow system for software delivery with AI",
        "version": "${version}",
        "author": {
          "name": "Michal Bienkowski"
        },
        "license": "AGPL-3.0",
        "homepage": "https://github.com/mbienkowski/hercules",
        "repository": "https://github.com/mbienkowski/hercules",
        "keywords": [
          "methodology",
          "workflow",
          "spec-driven",
          "tdd",
          "delivery",
          "code-review",
          "agents"
        ],
        "skills": "./skills/",
        "hooks": "./hooks/hooks.json"
      }
    },
    {
      "dest": "hooks/hooks.json",
      "content": {
        "hooks": {
          "PreToolUse": [
            {
              "matcher": "apply_patch|Bash",
              "hooks": [
                {
                  "type": "command",
                  "command": "python3 \"$PLUGIN_ROOT/hooks/hercules_gate.py\" codex_pre_tool"
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "guard": [
    "hercules_state.py",
    "frozen_tests.py",
    "hercules_gate.py"
  ],
  "tools": [
    "project_reset.py"
  ],
  "gate": {
    "protocol": "codex_pre_tool",
    "tools": {
      "apply_patch": "Edit",
      "Bash": "Bash"
    },
    "path_keys": [
      "path",
      "file_path",
      "filePath",
      "filename",
      "fileName",
      "file",
      "notebook_path",
      "notebookPath",
      "target_file",
      "targetFile",
      "absolute_path",
      "absolutePath"
    ],
    "nested_keys": [
      "edits",
      "changes",
      "operations"
    ],
    "allow": {
      "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "allow"
      }
    },
    "deny": {
      "hookSpecificOutput": {
        "hookEventName": "PreToolUse",
        "permissionDecision": "deny"
      }
    },
    "reason_key": "permissionDecisionReason"
  }
}
