{
  "$schema": "./recipe.schema.json",
  "name": "copilot-cli",
  "variables": {
    "advisor_delivery": "agent",
    "agent_mode": false,
    "agent_models": false,
    "agent_name_prefix": "",
    "agent_ns": "",
    "agent_tools": false,
    "agents_readonly": false,
    "command_agent": false,
    "command_disable_invocation": false,
    "command_format": "frontmatter",
    "command_name": false,
    "command_name_prefix": "",
    "command_title": "none",
    "command_wide_gap": false,
    "forced_subagent": "no",
    "host": "Copilot",
    "instructions_file": "AGENTS.md",
    "lead_edit_block": "none",
    "model_high": false,
    "model_low": false,
    "model_medium": false,
    "ns": "/",
    "persona_frontmatter": false,
    "plan_enter": "plan mode",
    "plan_exit": "approval",
    "plan_mode": "prose",
    "plugin_manifest_dir": false,
    "plugin_root": "${PLUGIN_ROOT}/",
    "product": "GitHub Copilot CLI",
    "version_manifest": false,
    "write_backstop": false
  },
  "runtime_variables": [
    "PLUGIN_ROOT"
  ],
