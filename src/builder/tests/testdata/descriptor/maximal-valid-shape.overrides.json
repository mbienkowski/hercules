{
  "guard": [
    "frozen_tests.py"
  ],
  "models": {
    "high": "big-model",
    "medium": "mid-model",
    "low": null
  },
  "roles": {
    "agent": {
      "mode": "fields",
      "body": "lstrip_newlines",
      "fields": [
        {
          "key": "name",
          "from": "stem"
        },
        {
          "key": "description",
          "from": "frontmatter",
          "field": "description",
          "render": true
        },
        {
          "key": "primary",
          "from": "primary_mode",
          "primary": "hercules"
        },
        {
          "key": "kind",
          "from": "literal",
          "value": "agent"
        },
        {
          "key": "flagged",
          "from": "flag_if_name_in",
          "names": [
            "hercules"
          ],
          "value": "true"
        }
      ]
    },
    "command": {
      "mode": "toml_command",
      "fields": [
        {
          "key": "description",
          "from": "stem"
        }
      ]
    },
    "persona": {
      "mode": "wrap",
      "fields": [
        {
          "key": "kind",
          "from": "literal",
          "value": "persona"
        }
      ]
    },
    "default": {
      "mode": "preserve",
      "resolve_model_tier": true,
      "required": [
        "name"
      ],
      "inject": [
        {
          "key": "denied",
          "from": "literal",
          "value": "Edit, Write"
        },
        {
          "key": "flagged",
          "from": "flag_if_name_in",
          "names": [
            "hercules"
          ],
          "value": "yes"
        }
      ]
    }
  },
  "routes": [
    {
      "kind": "exact",
      "src": "persona.md",
      "dest": "PERSONA.md"
    },
    {
      "kind": "suffix_swap",
      "prefix": "commands/",
      "from_suffix": ".md",
      "to_suffix": ".toml"
    },
    {
      "kind": "omit",
      "src": "capabilities.md"
    }
  ],
  "artifacts": [
    {
      "dest": "plugin.json",
      "content": {
        "name": "eco"
      },
      "versioned": false
    }
  ],
  "templates": [
    {
      "src": "eco.template.plugin.js",
      "dest": "plugin.js",
      "values": {
        "__NAME__": {
          "from": "js_string",
          "value": "eco"
        },
        "__ASSETS__": {
          "from": "js_string_list",
          "values": [
            "a.md"
          ]
        },
        "__PATHS__": {
          "from": "js_root_joins",
          "paths": [
            "skills"
          ]
        },
        "__AGENTS__": {
          "from": "role_entries_js",
          "role": "agent",
          "drop": [
            "kind"
          ],
          "body_key": "prompt"
        }
      }
    }
  ]
}
