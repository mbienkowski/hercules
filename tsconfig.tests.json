{
  // Type-check config for every domain's tests/ tree, the shared src/tests/support/ helpers, and the
  // Vitest config itself. ESM, never emitted — Vitest compiles tests from source, so this project's
  // module format never reaches Node's loader and cannot affect the shipped CommonJS plugin.
  //
  // `moduleResolution: bundler` matches how Vite actually resolves these files at runtime, so what
  // type-checks here is what executes there.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  // Specs import the modules under test from src/builder/, src/release/, src/metrics/, a separate project.
  "references": [{ "path": "./tsconfig.build.json" }],
  "include": [
    "src/builder/tests/**/*.ts",
    "src/release/tests/**/*.ts",
    "src/metrics/tests/**/*.ts",
    "src/content/tests/**/*.ts",
    "src/tests/support/**/*.ts",
    "*.config.mts"
  ]
}
