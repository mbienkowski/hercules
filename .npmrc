# Lifecycle scripts are disabled for every install, everywhere.
#
# A dependency's postinstall runs with the full ambient environment of whatever job installed it.
# In CI that once meant a job holding a contents:write git credential helper and, later in the same
# workflow, an npm publish token — so a single malicious postinstall could push to main or plant a
# wrapper on PATH for the publish step to execute. release.yml is structured so `npm ci` never
# shares a job with a privileged credential; this file is the second, unconditional layer.
#
# Nothing this project depends on needs a lifecycle script to function. If a future dependency
# genuinely does, it gets an explicit, reviewed, single-package exception — never a global flip.
ignore-scripts=true

# Exact versions only. A caret range is how a tokenizer minor bump silently moves the token counts
# that tests/testdata/thresholds.json gates on — gpt-tokenizer shipped exactly that (a split-regex
# fix in 3.3.0 that changed counts). Every dependency is pinned; Dependabot proposes bumps as
# reviewable PRs.
save-exact=true
