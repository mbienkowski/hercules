# Lifecycle scripts are disabled for every install, everywhere: a dependency's postinstall would run
# with whatever git or npm publish credential the installing job holds. Exceptions are per-package.
ignore-scripts=true

# Exact versions only — a caret range is how a tokenizer minor bump silently moves the token counts
# that tests/content/promptBudgets.spec.ts gates on. Dependabot proposes every bump as a reviewable PR.
save-exact=true
