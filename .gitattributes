# Normalise every text file to LF in the repository. The build compiler parses markdown with native
# LF line handling (src/builder/parse.mts uses String.split('\n')/trim() rather than reproducing
# Python's full splitlines() boundary set), so LF-only sources are a guaranteed invariant here, not a
# convention — a CRLF file can never enter and silently change how frontmatter is parsed. Binary
# files are auto-detected and left untouched.
* text=auto eol=lf
