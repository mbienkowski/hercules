# LF everywhere: the build renders whole files and the byte gate compares them, so a CRLF source
# would silently change the shipped bytes. Binary files are auto-detected and left alone.
* text=auto eol=lf

# Generated, not authored — collapsed in review by default (still expandable, still diffed).
# dist/ is the compiled plugin output, gated for drift by `make ci-build`; the lockfile is npm's.
dist/** linguist-generated=true
package-lock.json linguist-generated=true
