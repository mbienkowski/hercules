{
  // Root project. Holds no files of its own — it exists so editors and `tsc -b` see both halves of
  // the tree. `npm run typecheck` builds both referenced projects.
  //
  //   tsconfig.build.json  — src/{builder,release,metrics}/  -> ESM, .mts sources emitted as .mjs
  //                           into .ts-out/
  //   tsconfig.tests.json  — every domain's own tests/       -> ESM, type-checked only
  //
  // Shared compiler options live in tsconfig.base.json.
  "files": [],
  "references": [{ "path": "./tsconfig.build.json" }, { "path": "./tsconfig.tests.json" }]
}
