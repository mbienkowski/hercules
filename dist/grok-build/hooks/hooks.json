{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${GROK_PLUGIN_ROOT}/hooks/frozen_tests.py"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${GROK_PLUGIN_ROOT}/hooks/document_gate.py",
              "advance"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${GROK_PLUGIN_ROOT}/hooks/document_gate.py",
              "review"
            ]
          }
        ]
      }
    ]
  }
}
