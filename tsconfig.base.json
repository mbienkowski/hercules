{
  // Shared compiler options. Two projects extend this:
  //
  //   tsconfig.build.json  — scripts-ts/  -> ESM, .mts sources emitted as .mjs into .ts-out/
  //   tsconfig.tests.json  — tests-ts/    -> ESM, type-checked only (Vitest executes from source)
  //
  // ── Why package.json has NO "type" field (do not add one) ────────────────────────────────────
  // package.json's `main` is dist/opencode/plugin.js — the compiled, SHIPPED OpenCode plugin — and
  // that file is CommonJS (require / __dirname / module.exports). Node decides a .js file's module
  // format from the nearest package.json "type" field, so declaring "type": "module" would
  // reinterpret the shipped plugin as ESM and break it for every OpenCode user.
  //
  // The toolchain sidesteps that entirely by using .mts sources, which emit .mjs — a file Node
  // always loads as ESM regardless of any "type" field. So scripts-ts/ gets modern ESM and the
  // shipped plugin stays CommonJS, with no shared switch between them. It also avoids a real
  // dependency problem: js-tiktoken publishes ONE `types` condition shared by its CJS and ESM
  // entries, so a CommonJS consumer cannot type-check against it at all.
  //
  // tests-ts/packaging.spec.ts pins the absent "type" field, paired with a positive assertion that
  // the shipped plugin really does use require/__dirname, so this cannot regress silently.
  //
  // `verbatimModuleSyntax` is deliberately NOT set: it forbids the resolution-mode-inferred imports
  // this layout relies on. `isolatedModules` plus explicit `import type` covers the import-elision
  // correctness it would otherwise buy.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],

    // Strictness. TypeScript was chosen here for precision — these are the flags that deliver it,
    // not `strict` alone.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,

    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  }
}
